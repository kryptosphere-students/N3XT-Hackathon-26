# Copy to .env and fill in locally. Never commit .env.
# Testnet keys only. No seed phrase, no Flex PIN, no Key Ring password here:
# the Key Ring password stays in the OS keychain and is injected as WALLET_PASS.
# Details: docs-clearing-house-web3/dev/PLACEHOLDERS.md

# --- Chain (Base Sepolia) ---
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# Test wallets (create with `cast wallet new`, fund with the Base Sepolia faucet).
# The *_PUBLIC_KEY variables hold the addresses of those wallets.
DEPLOYER_PUBLIC_KEY=
AGENT_PUBLIC_KEY=
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# Contract verification (Etherscan multichain API or Basescan, check at S-014)
ETHERSCAN_API_KEY=

# --- Contract addresses (filled after deployment, S-014 and S-041) ---
SHARE_TOKEN_ADDRESS=
CASH_TOKEN_ADDRESS=
ESCROW_ADDRESS=

# --- Participants: Flex accounts 0, 1, 2 (S-007) ---
PARTICIPANT_A_ADDRESS=
PARTICIPANT_B_ADDRESS=
PARTICIPANT_C_ADDRESS=
# The fund is a participant too. Empty: the deployer address is used.
FUND_ADDRESS=

# --- Server and agents ---
SERVER_PORT=8787
NAV_SCENARIO=normal
INSTRUCTION_SIGNING_MODE=eip191
KEY_RING_KEY_NAME=clearing-house-config

# LLM through OpenRouter (OpenAI compatible API)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_FALLBACK_MODEL=qwen/qwen3.7-flash

# --- Web (VITE_ variables are public, read by the browser: no secrets) ---
VITE_SERVER_URL=http://localhost:8787
VITE_CHAIN_ID=84532
VITE_ESCROW_ADDRESS=
VITE_LEDGER_ORIGIN_TOKEN=
