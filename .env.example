# Copy to .env and fill locally. NEVER commit .env.
# Never put a seed phrase or private key here: the Ledger device holds the keys.

# LLM provider
ANTHROPIC_API_KEY=your-key-here

# RPC endpoint (chain to be decided)
RPC_URL=https://...

# Ledger Key Ring password: do NOT store it here.
# Keep it in the OS keychain and inject it at runtime, e.g.
#   WALLET_PASS="$(security find-generic-password -s ledger-ring -w)"   # macOS
#   WALLET_PASS="$(secret-tool lookup service ledger-ring)"            # Linux
