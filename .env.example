# Copy to .env and fill in locally. Never commit .env.
# No seed phrase or private key of the user here: the Ledger holds those.

ANTHROPIC_API_KEY=your-key-here
RPC_URL=https://sepolia.base.org

# Keeper key of the agent (testnet only, holds a bit of gas, nothing else)
AGENT_PRIVATE_KEY=

# The Key Ring password does not go here. Keep it in the OS password store
# and pass it as WALLET_PASS when running wallet-cli.
